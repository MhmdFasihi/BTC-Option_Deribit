# =============================================================================
# qortfolio (Streamlit v1)  ->  copy to /opt/qortfolio/.env  and fill in
# Generate secrets:  openssl rand -hex 32
# =============================================================================

# --- Application ---
ENVIRONMENT=production
APP_NAME=Qortfolio
DEBUG=false
LOG_LEVEL=INFO

# --- Data providers ---
# Deribit (primary options data): https://www.deribit.com/account/api
DERIBIT_API_URL=https://www.deribit.com/api/v2
DERIBIT_CLIENT_ID=__FILL_ME__
DERIBIT_CLIENT_SECRET=__FILL_ME__
# CoinGecko (optional, has free tier)
COINGECKO_API_KEY=

# --- Database (v1 default = SQLite file inside the data volume) ---
DATABASE_URL=sqlite:////app/data/qortfolio.db

# --- Cache (matches the redis service in docker-compose.vps.yml) ---
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300

# --- Security ---
SECRET_KEY=__RUN: openssl rand -hex 32__

# --- Feature flags ---
ENABLE_REAL_TIME_DATA=true
ENABLE_BACKTESTING=true
ENABLE_RISK_MANAGEMENT=true
ENABLE_CACHE=true
