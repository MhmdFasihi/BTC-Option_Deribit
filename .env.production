# =============================================================================
# Qortfolio Production Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=production
APP_NAME=Bitcoin Options Analytics
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# API CREDENTIALS
# =============================================================================

# Deribit API (Primary data source)
# Get credentials at: https://www.deribit.com/account/api
DERIBIT_API_URL=https://history.deribit.com/api/v2
DERIBIT_CLIENT_ID=your_deribit_client_id
DERIBIT_CLIENT_SECRET=your_deribit_client_secret

# CoinGecko API (Optional - has free tier)
# Get key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# =============================================================================
# DATABASE
# =============================================================================

# SQLite (default - simple single-file database)
DATABASE_URL=sqlite:///data/options_analytics.db

# PostgreSQL (uncomment for production with PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/options_analytics

# =============================================================================
# REDIS CACHE
# =============================================================================

# Redis connection (matches docker-compose service name)
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=3600

# Cache TTL settings (seconds)
DATA_CACHE_TTL=1800
PRICE_CACHE_TTL=60
MODEL_CACHE_TTL=3600

# =============================================================================
# STREAMLIT
# =============================================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =============================================================================
# RATE LIMITING
# =============================================================================

DERIBIT_RATE_LIMIT=10
API_TIMEOUT=30
CONNECTION_TIMEOUT=10
MAX_RETRIES=3

# =============================================================================
# FINANCIAL MODEL DEFAULTS
# =============================================================================

DEFAULT_RISK_FREE_RATE=0.05
GREEKS_PRECISION=6
PRICE_PRECISION=2
IV_PRECISION=4

# =============================================================================
# SECURITY
# =============================================================================

# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_REAL_TIME_DATA=true
ENABLE_BACKTESTING=true
ENABLE_RISK_MANAGEMENT=true
ENABLE_CACHE=true
